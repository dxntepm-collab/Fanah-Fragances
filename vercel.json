{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "artifacts/decants-shop/dist/public",
  "version": 2,
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/[...slug].js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}